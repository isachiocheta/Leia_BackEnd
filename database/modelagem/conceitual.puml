@startuml LeiaMaisConceitual
hide methods
skinparam linetype ortho

entity "Usuário" as usuario {
  * identificador
  --
  * nome {até 100 caracteres, não vazio}
  * email {único, minúsculo, sem espaços nas bordas}
  * hash de senha
  * perfil {ADMIN_CLUBE, LEITOR; padrão LEITOR}
  * situação {PENDENTE, ATIVO, INATIVO; padrão PENDENTE}
}

entity "Gênero" as genero {
  * identificador
  --
  * nome {único, até 60 caracteres, não vazio}
}

entity "Livro" as livro {
  * identificador
  --
  * título {até 160 caracteres, não vazio}
  * autor {até 120 caracteres, não vazio}
  * total de páginas {inteiro maior que zero}
  ano de publicação {inteiro positivo, opcional}
  descrição {até 2000 caracteres, opcional}
  URL da capa {opcional}
}

entity "Ciclo de leitura" as ciclo {
  * identificador
  --
  * nome {até 120 caracteres, não vazio}
  * data de início {DATE, data civil}
  * data de fim {DATE, data civil}
  * situação {PLANEJADO, EM_ANDAMENTO, CONCLUIDO; padrão PLANEJADO}
  orientações {até 2000 caracteres, opcionais}
}

entity "Encontro" as encontro {
  * identificador
  --
  * título {até 120 caracteres, não vazio}
  * início {instante com fuso, TIMESTAMP WITH TIME ZONE}
  * local {até 180 caracteres, não vazio}
  * situação {AGENDADO, REALIZADO, CANCELADO; padrão AGENDADO}
  descrição {até 2000 caracteres, opcional}
}

entity "Participação de leitura" as participacao {
  * identificador
  --
  * página atual {inteiro maior ou igual a zero; padrão zero}
  concluída em {instante com fuso, opcional}
  par usuário / ciclo {único}
}

entity "Inscrição em encontro" as inscricao {
  * identificador
  --
  par usuário / encontro {único}
}

package "Metadados técnicos de carga" {
  entity "cargas_demonstracao" as manifesto_demo <<técnica>> {
    * chave {PK, varchar(60)}
    * data-base {DATE}
    * manifesto {JSONB: versão e IDs}
    * criado em {instante com fuso}
  }

  entity "sequelize_seeds" as historico_seeds <<técnica>> {
    * nome do arquivo {PK}
  }

  entity "generos_semeados" as origem_genero <<técnica>> {
    * semeador {PK}
    * gênero inserido {PK, FK}
  }
}

genero ||--o{ livro : classifica
livro ||--o{ ciclo : fundamenta
ciclo ||--o{ encontro : organiza
usuario ||--o{ participacao : adere
ciclo ||--o{ participacao : recebe
usuario ||--o{ inscricao : manifesta intenção
encontro ||--o{ inscricao : recebe
genero ||..o{ origem_genero : proveniência técnica

note right of origem_genero
  Registra apenas IDs que o seeder realmente inseriu.
  Um gênero preexistente reutilizado não recebe proveniência.
  A reversão só pode remover os gêneros comprovadamente criados.
  Excluir gênero limpa sua metadata (CASCADE), sem apagar
  livros ou histórico do domínio; a FK dos livros segue RESTRICT.
  semeador identifica o arquivo, sem FK para sequelize_seeds:
  o CLI registra a execução após o retorno do seeder.
end note

note right of historico_seeds
  Histórico de execução do seederStorage no banco.
  A carga padrão contém apenas gêneros de referência:
  Aventura, Conto, Fábula, Ficção científica, Poesia e Romance.
  Não contém usuários, livros ou dados demonstrativos.
  O bootstrap administrativo é um comando separado.
end note

note right of participacao
  Participação é adesão do usuário ao ciclo de leitura.
  Cada par usuário / ciclo possui uma única participação.
  A página atual é inteira e não negativa; a conclusão
  é um instante opcional, sem percentual ou contador derivado.
  FKs para usuário e ciclo usam exclusão RESTRICT.
end note

note right of inscricao
  Inscrição é intenção de comparecer, não presença.
  Cada par usuário / encontro possui uma única inscrição.
  Usuário referenciado não pode ser excluído (RESTRICT).
  Excluir encontro remove somente suas inscrições (CASCADE),
  sem apagar participações, usuários ou ciclos.
end note

note right of encontro
  Cada encontro pertence a exatamente um ciclo.
  Aliases no model: ciclo.encontros e encontro.ciclo.
  A regra de início dentro do período do ciclo depende
  de outra tabela e da convenção de fuso do clube;
  será validada no serviço, sem CHECK entre tabelas.
end note

legend bottom
  |= Notação |= Participação e cardinalidade |
  | || | exatamente 1: participação total no lado dependente |
  | o{ | 0..N: participação parcial no lado principal |
  | * atributo | obrigatório |
  Cada livro exige um gênero; cada ciclo exige um livro;
  cada encontro exige um ciclo. Participações e inscrições
  exigem as duas entidades relacionadas.
  Usuários, gêneros, livros, ciclos e encontros podem existir
  sem registros dependentes (participação parcial).
endlegend

note as normalizacao
  Normalização: atributos atômicos e dependências da chave;
  ausência de atributos derivados e dependências transitivas (3FN).
  Um autor informado em texto e um gênero por livro.
  Livro representa a obra cadastrada; cada uso em leitura
  é um ciclo distinto, sem duplicar a obra ou seus atributos.
  Ano de publicação é positivo quando informado; o limite
  superior pelo ano corrente pertence ao serviço futuro.
  Relações muitos para muitos usuário/ciclo e usuário/encontro
  resolvidas, respectivamente, por participações e inscrições.
  Sem percentual de leitura, contador redundante ou presença.
  Usuário ativo, limite superior da página pelo total do livro
  e inscrição no mesmo ciclo serão validados nos serviços;
  não são restrições entre tabelas impostas pelo schema.
  Datas de ciclo obrigatórias, com fim maior ou igual ao início.
  Datas civis não são instantes UTC e não mudam de dia por fuso.
  O início do encontro é um instante absoluto; a apresentação
  pode variar por fuso, preservando o mesmo instante.
  Situação é explícita, nunca derivada automaticamente das datas.
  Uma obra pode possuir vários ciclos planejados ou concluídos.
  No máximo um ciclo EM_ANDAMENTO em toda a instalação:
  índice único parcial sobre a constante 1, apenas nessa situação.
  Essa unicidade global não torna livro ou data exclusivos.
  Um único clube: nenhuma entidade clube ou chave de locatário.
end note

note as infraestrutura
  cargas_demonstracao é controle técnico opcional: chave PK varchar(60),
  data_base DATE, manifesto JSONB (versão e IDs) e criado_em com fuso,
  todos obrigatórios. Não guarda senhas, hash, progresso ou cópias de datas.
  Não pertence ao domínio e não possui FKs; reexecução recusa referências
  removidas ou conflitantes sem restaurá-las. Referência básica não cria linha.
  criadoEm e atualizadoEm são atributos técnicos de auditoria.
  sessionVersion é uma versão técnica de credenciais/sessões:
  inteiro obrigatório, com padrão zero e valor maior ou igual a zero.
  sequelize_meta controla migrations, fora do domínio do clube.
  sequelize_seeds controla a execução dos seeders de referência;
  generos_semeados guarda sua proveniência, sem novos atributos
  nas entidades do domínio. A cascata dessa metadata técnica
  não apaga o histórico de participações ou inscrições.
  sessoes é infraestrutura compatível com connect-pg-simple:
  sid (PK), sess (JSON obrigatório) e expire (timestamp(6) obrigatório,
  sem fuso horário), com índice de expiração e sem outras colunas.
  Não há FK para usuário: o conteúdo da sessão permanece em sess.
  Sessões não representam participações ou inscrições do domínio.
  Consultas públicas omitem o hash; o escopo credenciais o inclui.
  As migrations são a autoridade do schema; manter este diagrama,
  o modelo lógico e os modelos JavaScript consistentes com elas.
end note

@enduml
