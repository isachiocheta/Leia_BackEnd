// Modelo em 3FN: atributos atômicos e dependentes da chave, sem dependências transitivas.
// Simplificações: um autor informado em texto e um gênero obrigatório por livro.
// Livro é a obra cadastrada; ciclos_leitura registra cada uso dessa obra no clube.
// O banco valida ano positivo; o limite superior pelo ano corrente será do serviço.
// M:N resolvidas por participacoes_leitura e inscricoes_encontro; pares únicos.
// Participação é adesão ao ciclo; inscrição é intenção de comparecer, não presença.
// Um único clube escolar. Nenhum percentual, contador redundante ou presença é armazenado.
// JavaScript usa camelCase; colunas e tabelas PostgreSQL usam snake_case.
// As migrations são a autoridade do schema. Atualizar estes modelos junto delas.

Project leia_mais {
  database_type: 'PostgreSQL'
  Note: 'Domínio de um clube do livro escolar; tabelas técnicas separadas ao final.'
}

// Controle técnico da carga opcional; não é entidade do clube. O manifesto
// guarda somente versão e mapas de IDs, sem senha/hash, progresso ou datas das
// entidades. Não possui FKs para o domínio: ausências impedem reexecução, sem
// apagar/restaurar registros por cascata. Sem linha quando só há referência.
Table cargas_demonstracao {
  chave varchar(60) [pk, not null]
  data_base date [not null]
  manifesto jsonb [not null]
  criado_em timestamptz [not null]
}

Table usuarios {
  id integer [pk, increment, not null]
  nome varchar(100) [not null, note: 'Não pode ser vazio ou conter somente espaços em branco.']
  email varchar(254) [not null, unique, note: 'Normalizado por trim/lower no model; SQL direto exige formato normalizado.']
  senha_hash text [not null, note: 'Somente hash, sem valor padrão; omitido das consultas públicas.']
  perfil varchar(20) [not null, default: 'LEITOR', note: 'CHECK: perfil IN (ADMIN_CLUBE, LEITOR)']
  situacao varchar(10) [not null, default: 'PENDENTE']
  session_version integer [not null, default: 0, note: 'Versão técnica; zero é válido.']
  criado_em timestamptz [not null]
  atualizado_em timestamptz [not null]

  checks {
    `nome ~ '[^[:space:]]'` [name: 'usuarios_nome_nao_vazio']
    `email = lower(btrim(email)) AND length(btrim(email)) > 0` [name: 'usuarios_email_normalizado']
    `length(btrim(senha_hash)) > 0` [name: 'usuarios_senha_hash_nao_vazio']
    `perfil IN ('ADMIN_CLUBE', 'LEITOR')` [name: 'usuarios_perfil_valido']
    `situacao IN ('PENDENTE', 'ATIVO', 'INATIVO')` [name: 'usuarios_situacao_valida']
    `session_version >= 0` [name: 'usuarios_session_version_nao_negativa']
  }
}

Table generos {
  id integer [pk, increment, not null]
  nome varchar(60) [not null, unique]
  criado_em timestamptz [not null]
  atualizado_em timestamptz [not null]

  checks {
    `nome ~ '[^[:space:]]'` [name: 'generos_nome_nao_vazio']
  }
}

Table livros {
  id integer [pk, increment, not null]
  titulo varchar(160) [not null]
  autor varchar(120) [not null]
  genero_id integer [not null]
  total_paginas integer [not null]
  ano_publicacao integer
  descricao varchar(2000)
  capa_url text
  criado_em timestamptz [not null]
  atualizado_em timestamptz [not null]

  checks {
    `titulo ~ '[^[:space:]]'` [name: 'livros_titulo_nao_vazio']
    `autor ~ '[^[:space:]]'` [name: 'livros_autor_nao_vazio']
    `total_paginas > 0` [name: 'livros_total_paginas_positivo']
    `ano_publicacao IS NULL OR ano_publicacao > 0` [name: 'livros_ano_publicacao_positivo']
  }
}

Table ciclos_leitura {
  id integer [pk, increment, not null]
  nome varchar(120) [not null]
  livro_id integer [not null]
  data_inicio date [not null, note: 'Data civil; DATEONLY no model, sem conversão UTC.']
  data_fim date [not null, note: 'Data civil; DATEONLY no model, sem conversão UTC.']
  orientacoes varchar(2000)
  situacao varchar(20) [not null, default: 'PLANEJADO', note: 'Explícita; nunca derivada das datas.']
  criado_em timestamptz [not null]
  atualizado_em timestamptz [not null]

  checks {
    `nome ~ '[^[:space:]]'` [name: 'ciclos_leitura_nome_nao_vazio']
    `data_fim >= data_inicio` [name: 'ciclos_leitura_periodo_valido']
    `situacao IN ('PLANEJADO', 'EM_ANDAMENTO', 'CONCLUIDO')` [name: 'ciclos_leitura_situacao_valida']
  }

  // DBML não suporta o predicado WHERE de índices parciais. O SQL exato fica
  // na nota, sem declarar um índice único incondicional ou unique(livro_id).
  Note: '''
    Índice único parcial global, definido pela migration:
    CREATE UNIQUE INDEX ciclos_leitura_unico_em_andamento
      ON ciclos_leitura ((1)) WHERE situacao = 'EM_ANDAMENTO';
    Garante no máximo um ciclo EM_ANDAMENTO em toda a instalação.
    A mesma obra pode possuir vários ciclos; planejados e concluídos coexistem.
    Nenhum indicador calculado é armazenado.
  '''
}

Table encontros {
  id integer [pk, increment, not null]
  ciclo_id integer [not null]
  titulo varchar(120) [not null]
  inicio_em timestamptz [not null, note: 'Instante absoluto, armazenado com fuso; a apresentação pode variar por fuso.']
  local varchar(180) [not null]
  descricao varchar(2000)
  situacao varchar(20) [not null, default: 'AGENDADO']
  criado_em timestamptz [not null]
  atualizado_em timestamptz [not null]

  checks {
    `titulo ~ '[^[:space:]]'` [name: 'encontros_titulo_nao_vazio']
    `local ~ '[^[:space:]]'` [name: 'encontros_local_nao_vazio']
    `situacao IN ('AGENDADO', 'REALIZADO', 'CANCELADO')` [name: 'encontros_situacao_valida']
  }

  indexes {
    (ciclo_id, inicio_em) [name: 'encontros_ciclo_inicio_indice']
    inicio_em [name: 'encontros_inicio_indice']
  }

  // O índice composto atende consultas por ciclo e ordenação por início;
  // seu prefixo já atende ciclo_id, portanto não há índice isolado redundante.
  // O índice por inicio_em atende a ordem cronológica entre todos os ciclos.
  Note: '''
    A regra de encontro dentro do período de ciclos_leitura depende de outra
    tabela e de uma convenção de fuso; será validada no serviço.
    Não há CHECK nem trigger entre tabelas para essa regra.
    Associações no model: CicloLeitura.encontros e Encontro.ciclo, com cicloId.
  '''
}

Table participacoes_leitura {
  id integer [pk, increment, not null]
  usuario_id integer [not null]
  ciclo_id integer [not null]
  pagina_atual integer [not null, default: 0]
  concluida_em timestamptz
  criado_em timestamptz [not null]
  atualizado_em timestamptz [not null]

  checks {
    `pagina_atual >= 0` [name: 'participacoes_leitura_pagina_nao_negativa']
  }

  indexes {
    (usuario_id, ciclo_id) [unique, name: 'participacoes_leitura_usuario_ciclo_unico']
  }

  Note: '''
    Adesão do usuário ao ciclo; um único registro por par usuário/ciclo.
    O limite superior da página, conforme o total do livro, e a condição de
    usuário ativo serão validados nos serviços. Não há CHECK entre tabelas.
    Excluir usuário ou ciclo referenciado é bloqueado por RESTRICT,
    preservando o histórico sem cascata de exclusão.
  '''
}

Table inscricoes_encontro {
  id integer [pk, increment, not null]
  usuario_id integer [not null]
  encontro_id integer [not null]
  criado_em timestamptz [not null]
  atualizado_em timestamptz [not null]

  indexes {
    (usuario_id, encontro_id) [unique, name: 'inscricoes_encontro_usuario_encontro_unico']
  }

  Note: '''
    Intenção de comparecer ao encontro, não registro de presença.
    Usuário ativo e inscrição no mesmo ciclo serão verificados pelos serviços.
    A FK de usuário usa RESTRICT. A FK de encontro usa ON DELETE CASCADE:
    excluir encontro remove apenas as inscrições que o referenciam.
  '''
}

// FKs obrigatórias: dependentes participam totalmente, principais admitem 0..N dependentes.
// RESTRICT preserva histórico ao excluir usuários/ciclos. A única cascata de exclusão
// do domínio é encontros -> inscricoes_encontro; a proveniência técnica abaixo
// tem limpeza própria. Atualizações das chaves propagam por CASCADE.
Ref: livros.genero_id > generos.id [delete: restrict, update: cascade]
Ref: ciclos_leitura.livro_id > livros.id [delete: restrict, update: cascade]
Ref: encontros.ciclo_id > ciclos_leitura.id [delete: restrict, update: cascade]
Ref: participacoes_leitura.usuario_id > usuarios.id [delete: restrict, update: cascade]
Ref: participacoes_leitura.ciclo_id > ciclos_leitura.id [delete: restrict, update: cascade]
Ref: inscricoes_encontro.usuario_id > usuarios.id [delete: restrict, update: cascade]
Ref: inscricoes_encontro.encontro_id > encontros.id [delete: cascade, update: cascade]

// Infraestrutura: sequelize-cli cria esta tabela; ela não é criada pela migration do domínio.
// A coluna name é o contrato técnico do CLI, mantida sem tradução.
Table sequelize_meta {
  name varchar(255) [pk, not null]
  Note: 'Tabela técnica: nomes das migrations executadas. Não pertence ao domínio.'
}

// Contrato técnico do seederStorage do sequelize-cli; a migration cria a tabela.
Table sequelize_seeds {
  name varchar(255) [pk, not null]
  Note: 'Histórico de execução dos seeders no banco; name mantém o contrato do CLI.'
}

Table generos_semeados {
  semeador varchar(255) [not null]
  genero_id integer [not null]

  indexes {
    (semeador, genero_id) [pk]
  }

  Note: '''
    Proveniência técnica: apenas IDs de gêneros efetivamente criados pelo seeder.
    Gêneros preexistentes reutilizados não são registrados e não são apagados
    pela reversão. A FK CASCADE limpa somente esta metadata quando o gênero
    é excluído; a FK RESTRICT de livros continua protegendo referências em uso.
    semeador identifica o arquivo, sem FK para sequelize_seeds, pois o CLI grava
    o histórico depois que o seeder retorna.
    Carga padrão: Aventura, Conto, Fábula, Ficção científica, Poesia e Romance.
    Não cria usuários, livros ou dados demonstrativos. O bootstrap administrativo
    é um comando separado, sem novos atributos de domínio.
  '''
}

Ref: generos_semeados.genero_id > generos.id [delete: cascade, update: cascade]

// Contrato técnico do connect-pg-simple; configurar tableName como sessoes.
// Não há timestamps de auditoria, FK usuario_id nem colunas de outro store.
// sess é JSON (não JSONB); expire é timestamp sem fuso, com precisão de 6 dígitos.
Table sessoes {
  sid varchar [pk, not null]
  sess json [not null]
  expire timestamp(6) [not null]

  indexes {
    expire [name: 'sessoes_expire_indice']
  }

  Note: 'Infraestrutura de sessão; o conteúdo JSON não cria relações do domínio.'
}

TableGroup dominio {
  usuarios
  generos
  livros
  ciclos_leitura
  encontros
  participacoes_leitura
  inscricoes_encontro
}

TableGroup infraestrutura {
  cargas_demonstracao
  sequelize_meta
  sequelize_seeds
  generos_semeados
  sessoes
}

// criado_em/atualizado_em são metadados técnicos de auditoria das entidades.
// session_version também é metadado técnico; os padrões LEITOR/PENDENTE
// não concedem privilégios administrativos ou ativação automática.
// sessoes permanece separada de participacoes_leitura e inscricoes_encontro.
