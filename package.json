{
  "name": "leia-mais-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API do clube do livro escolar Leia+",
  "type": "commonjs",
  "main": "app.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test testes/*.test.js",
    "test:integracao": "node --env-file-if-exists=.env --test testes/integracao/*.test.js",
    "test:migracoes": "node --env-file-if-exists=.env --test testes/migracoes/*.test.js",
    "test:cargas": "node --env-file-if-exists=.env --test testes/cargas/*.test.js",
    "db:verificar": "node --env-file-if-exists=.env database/verificar-conexao.js",
    "db:migrar": "node --env-file-if-exists=.env database/executar-cli.js db:migrate",
    "db:estado": "node --env-file-if-exists=.env database/executar-cli.js db:migrate:status",
    "db:reverter": "node --env-file-if-exists=.env database/executar-cli.js db:migrate:undo",
    "db:referencias": "node --env-file-if-exists=.env database/executar-cli.js db:seed:all",
    "db:referencias:reverter": "node --env-file-if-exists=.env database/executar-cli.js db:seed:undo --seed 20261030061000-carregar-generos-referencia.js",
    "db:admin": "node --env-file-if-exists=.env database/bootstrap-administrativo.js",
    "db:demo": "node --env-file-if-exists=.env database/carregar-demonstracao.js",
    "db:exportar-sql": "node --env-file-if-exists=.env database/exportar-sql.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.1"
  }
}
