NODE_ENV=development
PORT=3000
ALLOWED_ORIGIN=http://localhost:5173

# Gere um segredo aleatório de pelo menos 32 bytes e defina SESSION_SECRET no
# ambiente ou no .env local; não há segredo padrão. Obrigatório no startup.
SESSION_SECRET=
# HTTP local explícito. Em HTTPS e em production, use true.
SESSION_COOKIE_SECURE=false

# Substitua os marcadores pelas credenciais locais; não versione o arquivo .env.
DATABASE_URL=postgresql://usuario:senha_local@localhost:5432/leia_mais
TEST_DATABASE_URL=postgresql://usuario:senha_local@localhost:5432/leia_mais_teste
# Operações de teste e rollback exigem NODE_ENV=test e banco _test ou _teste.

# Apenas para npm run db:admin; não são exigidos no startup.
ADMIN_NOME=
ADMIN_EMAIL=
# Defina ADMIN_SENHA no ambiente: mínimo 10 caracteres e máximo 72 bytes UTF-8.
# A senha não tem valor padrão e seus espaços devem ser preservados.
