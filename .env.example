NODE_ENV=development
PORT=3000
ALLOWED_ORIGIN=http://localhost:5173

# Substitua os marcadores pelas credenciais locais; não versione o arquivo .env.
DATABASE_URL=postgresql://usuario:senha_local@localhost:5432/leia_mais
TEST_DATABASE_URL=postgresql://usuario:senha_local@localhost:5432/leia_mais_teste
# Operações de teste e rollback exigem NODE_ENV=test e banco _test ou _teste.
