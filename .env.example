NODE_ENV=development
PORT=3000
ALLOWED_ORIGIN=http://localhost:5173

# Gere um segredo aleatório de pelo menos 32 bytes e defina SESSION_SECRET no
# ambiente ou no .env local; não há segredo padrão. Obrigatório no startup.
SESSION_SECRET=
# HTTP local explícito. Em HTTPS e em production, use true.
SESSION_COOKIE_SECURE=false

# Substitua os marcadores pelas credenciais locais; não versione o arquivo .env.
DATABASE_URL=postgresql://usuario:senha_local@localhost:5432/leia_mais
TEST_DATABASE_URL=postgresql://usuario:senha_local@localhost:5432/leia_mais_teste
# Operações de teste e rollback exigem NODE_ENV=test e banco _test ou _teste.

# Apenas para npm run db:admin; não são exigidos no startup.
ADMIN_NOME=
ADMIN_EMAIL=
# Defina ADMIN_SENHA no ambiente: mínimo 10 caracteres e máximo 72 bytes UTF-8.
# A senha não tem valor padrão e seus espaços devem ser preservados.

# Opcional, somente npm run db:demo, após migrations e db:referencias.
# Data civil em America/Sao_Paulo. Vazia: hoje na primeira carga; nas demais,
# reutiliza a data registrada. Outra data explícita é conflito, sem mover datas.
DEMO_DATA_BASE=
# Defina no ambiente, sem senhas padrão e sem trim (10 caracteres..72 bytes):
# DEMO_SENHA_INICIO, DEMO_SENHA_METADE, DEMO_SENHA_FINAL,
# DEMO_SENHA_SEM_PARTICIPACAO e DEMO_SENHA_PENDENTE.
# Emails fixos: demo.inicio, demo.metade, demo.final, demo.sem.adesao e
# demo.pendente, todos @leia.example. Demo nunca é executada no startup.
# db:exportar-sql exige NODE_ENV=test, banco de teste distinto, pg_dump no PATH
# e permissão de CREATE DATABASE; usa um banco novo e o remove sem FORCE.
